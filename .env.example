# =============================================================================
# Cortex — .env.example
# =============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# .env is in .gitignore — never commit it.
# In Kubernetes, use Secrets instead.
# =============================================================================

# ── Server identity ───────────────────────────────────────────────────────────
CORTEX_SERVER_PLATFORM_ID=arm_east_01
CORTEX_SERVER_DEPLOYMENT_ID=prod
CORTEX_SERVER_LOG_LEVEL=INFO
CORTEX_SERVER_LOG_FORMAT=json

# ── API key authentication ────────────────────────────────────────────────────
# Generate with: cortex-keygen
# Format: key[:robot_id[:perm1+perm2]]
# Multiple keys: comma-separated
# Permissions: certify, record, memory, context, health, admin
#
CORTEX_API_KEYS=cx_live_your_key_here

# Set to 1 to disable auth (local dev ONLY — never in production)
CORTEX_SKIP_AUTH=0

# Set to 1 to reject all requests when no keys are configured (fail closed)
CORTEX_AUTH_REQUIRED=1

# ── TLS / mTLS (optional) ─────────────────────────────────────────────────────
# Generate dev certs with: cortex-gen-certs --robots arm_east_01,arm_west_02
#
CORTEX_TLS_ENABLED=0
CORTEX_TLS_MTLS=0
CORTEX_TLS_CERT_FILE=/var/cortex/certs/server.crt
CORTEX_TLS_KEY_FILE=/var/cortex/certs/server.key
CORTEX_TLS_CA_FILE=/var/cortex/certs/ca.crt

# ── Transport ─────────────────────────────────────────────────────────────────
CORTEX_GRPC_ENABLED=true
CORTEX_GRPC_PORT=50051
CORTEX_GRPC_MAX_WORKERS=10

CORTEX_HTTP_ENABLED=false
CORTEX_HTTP_PORT=8765

# ── Memory adapters ───────────────────────────────────────────────────────────
CORTEX_REDIS_ENABLED=true
CORTEX_REDIS_URL=redis://redis:6379
CORTEX_REDIS_PASSWORD=

CORTEX_WEAVIATE_ENABLED=false
CORTEX_WEAVIATE_URL=http://weaviate:8080
CORTEX_WEAVIATE_API_KEY=

CORTEX_MEM0_ENABLED=false
CORTEX_MEM0_API_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
CORTEX_METRICS_ENABLED=true
CORTEX_METRICS_PORT=9090

# Options: none, console, otlp
CORTEX_TRACING_EXPORTER=none
CORTEX_TRACING_ENDPOINT=http://otel-collector:4317

# ── Gate thresholds (production tuning) ──────────────────────────────────────
CORTEX_GATE_HUMAN_OVERRIDE_THRESHOLD=0.40
CORTEX_GATE_REPLAN_THRESHOLD=0.55

# ── Sentinel safety limits ────────────────────────────────────────────────────
CORTEX_SENTINEL_MAX_SPEED_MS=1.0
CORTEX_SENTINEL_MAX_FORCE_N=80.0
